#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/num_word.dtsi>       // Requires zmk-auto-layer module
#include <zmk-helpers/helper.h>          // Requires zmk-helpers module
#include <zmk-helpers/key-labels/34.h>   // Source key-labels

// Vars
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4   // Left-hand keys
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4   // Right-hand keys
#define THUMBS LH1 LH0 RH0 RH1		                                         // Thumb keys

#define XXX &none
#define ___ &trans

#define QWERTY 0
#define COLEMAK 1
#define NAV 2
#define NUM 3
#define FUN 4
#define WM 5
#define RARE 6

#define COMBO_PRIOR_IDLE 50
#define COMBO_TIMEOUT_MS 35

#define PRIOR_IDLE_MS 50
#define QUICK_TAP_MS 500

// Functions
#define COMBO(NAME, BINDINGS, KEYPOS, IDLE, MS)          \
    combo_##NAME {                                       \
        bindings = <BINDINGS>;                           \
        key-positions = <KEYPOS>;                        \
        require-prior-idle-ms = <IDLE>;                  \
        timeout-ms = <MS>;                               \
    };

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)           \
    ZMK_HOLD_TAP(NAME,                                   \
        bindings = <HOLD>, <TAP>;                        \
        flavor = "balanced";                             \
        tapping-term-ms = <200>;                         \
        quick-tap-ms = <QUICK_TAP_MS>;                   \
        require-prior-idle-ms = <PRIOR_IDLE_MS>;         \
        hold-trigger-on-release;                         \
        hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)   // Left-hand HRMs
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)   // Right-hand HRMs

// Behavior configuration
&lt {
    tapping-term-ms = <200>;
    quick_tap_ms = <0>;
    flavor = "tap-preferred";
};

&mt {
    tapping-term-ms = <200>;
    quick_tap_ms = <0>;
    flavor = "tap-preferred";
};

&sk {
    release-after-ms = <500>;
    quick-release;
};

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

&num_word {
    continue-list = <BSPC DEL DOT COMMA PLUS MINUS FSLH BSLH EQUAL UNDERSCORE COLON>;
    ignore-modifiers;
};

&mmv {
    time-to-max-speed-ms = <50>;
};

&msc {
    acceleration-exponent = <1>;
};

/ {
    combos {
        compatible = "zmk,combos";
        COMBO(rare, &mo RARE,  0 1, COMBO_PRIOR_IDLE, COMBO_TIMEOUT_MS)
        COMBO(lbkt, &kp LBKT,  1 2, COMBO_PRIOR_IDLE, COMBO_TIMEOUT_MS)
		COMBO(lpar, &kp LPAR,  2 3, COMBO_PRIOR_IDLE, COMBO_TIMEOUT_MS)
        COMBO(lbrc, &kp LBRC,  1 3, COMBO_PRIOR_IDLE, COMBO_TIMEOUT_MS)
		COMBO(rpar, &kp RPAR,  6 7, COMBO_PRIOR_IDLE, COMBO_TIMEOUT_MS)
        COMBO(rbkt, &kp RBKT,  7 8, COMBO_PRIOR_IDLE, COMBO_TIMEOUT_MS)
        COMBO(rbrc, &kp RBRC,  6 8, COMBO_PRIOR_IDLE, COMBO_TIMEOUT_MS)
        COMBO(resc, &kp ESC, 16 17, COMBO_PRIOR_IDLE, COMBO_TIMEOUT_MS)
        COMBO(lesc, &kp ESC, 12 13, COMBO_PRIOR_IDLE, COMBO_TIMEOUT_MS)
    };

	behaviors {
		hm: homerow_mods {
			compatible = "zmk,behavior-hold-tap";
			label = "HOMEROW_MODS";
			#binding-cells = <2>;
			tapping-term-ms = <200>;
			quick-tap-ms = <500>;
			flavor = "tap-preferred";
			bindings = <&kp>, <&kp>;
		};
	};

    keymap {
        compatible = "zmk,keymap";

		qwerty {
			bindings = <
				&kp Q        &kp W        &kp E         &kp R          &kp T           &kp Y        &kp U         &kp I         &kp O        &kp P
				&hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F   &kp G           &kp H        &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI
				&kp Z        &kp X        &kp C         &kp V          &kp B           &kp N        &kp M         &kp COMMA     &kp DOT      &kp FSLH
				                                        &lt NAV SPACE  &lt WM TAB      &lt FUN RET  &lt NUM BSPC
			>;
		};

		colemak {
			bindings = <
				&kp Q        &kp W        &kp F         &kp P          &kp B           &kp J         &kp L         &kp U         &kp Y        &kp SQT
				&hml LGUI A  &hml LALT R  &hml LCTRL S  &hml LSHFT T   &kp G           &kp M         &hmr RSHFT N  &hmr RCTRL E  &hmr RALT I  &hmr RGUI O
				&kp Z        &kp X        &kp C         &kp D          &kp V           &kp K         &kp H         &kp COMMA     &kp DOT      &kp FSLH
                                                        &lt NAV SPACE  &lt WM TAB      &lt FUN RET   &lt NUM BSPC
			>;
		};

		navigation {
			bindings = <
                &kp LC(Z)    &kp LC(V)    &kp LC(C)     &kp LC(X)      &kp LC(Y)       &kp CAPSLOCK  &kp PG_DN     &kp UP        &kp PG_UP    &caps_word
                &kp LGUI     &kp LALT     &kp LCTRL     &kp LSHFT      &kp PSCRN       &kp HOME      &kp LEFT      &kp DOWN      &kp RIGHT    &kp END
                ___          ___          &kp DEL       &kp RET        &kp BSPC        &kp INS       ___           ___           ___          &num_word
                                                        ___            ___             &kp RET       &kp BSPC
			>;
		};

		numbers {
			bindings = <
                &kp LBKT     &kp N7       &kp N8        &kp N9         &kp RBKT        ___           ___           ___           ___          ___
                &kp SQT      &kp N4       &kp N5        &kp N6         &kp EQUAL       ___           &kp LSHFT     &kp LCTRL     &kp LALT     &kp LGUI
                &kp GRAVE    &kp N1       &kp N2        &kp N3         &kp BSLH        ___           &key_repeat   ___           ___          ___
                                                        &kp N0         &kp MINUS       ___           &kp ESC
			>;
		};
 
		func {
			bindings = <
                &kp C_BRI_UP &kp F7       &kp F8        &kp F9         &kp F10         &kp C_VOL_UP  &kp C_PREV    &kp C_PP      &kp C_NEXT   ___
                &kp C_BRI_DN &kp F4       &kp F5        &kp F6         &kp F11         &kp C_VOL_DN  &kp LSHFT     &kp LCTRL     &kp LALT     &kp LGUI
                ___          &kp F1       &kp F2        &kp F3         &kp F12         &kp C_MUTE    &key_repeat   ___           ___          ___
                                                        ___            ___             ___           &kp ESC
			>;
		};

		wm {
            bindings = <
				___          &kp LG(Q)    &kp LG(W)     &kp LG(E)      &kp LG(R)       ___           ___           ___           ___          ___
				&kp LG(A)    &kp LG(N1)   &kp LG(N2)    &kp LG(N3)     &kp LG(F)       ___           &kp LSHFT     &kp LCTRL     &kp LALT     &kp LGUI
				&kp LG(X)    &kp LG(N4)   &kp LG(N5)    &kp LG(N6)     ___             ___           ___           ___           ___          ___
				                                        ___            ___             ___           ___
            >;
		};

		rare {
			bindings = <
				XXX   XXX   &bt BT_SEL 3   &bt BT_SEL 0   &bootloader        &bootloader      &msc SCRL_DOWN   &mmv MOVE_UP     &msc SCRL_UP      XXX
				XXX   XXX   &bt BT_SEL 4   &bt BT_SEL 1   &sys_reset         &sys_reset       &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_RIGHT   XXX
				XXX   XXX   &bt BT_SEL 5   &bt BT_SEL 2   &bt BT_CLR_ALL     &studio_unlock   &mkp LCLK        &mkp MCLK        &mkp RCLK         XXX
						                   XXX            XXX                &to QWERTY	      &to COLEMAK
			>;
		};

    };
};
